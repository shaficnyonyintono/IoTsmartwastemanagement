# Backend provider: "mock" | "django" | "firebase"
VITE_DATA_SOURCE=firebase

# Django REST API (used when VITE_DATA_SOURCE=django)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_BIN_NODE_ID=smart_bin_01
VITE_POLL_INTERVAL_MS=5000

# Fixed bin coordinates (rigid physical node)
VITE_BIN_LATITUDE=0.28771512921183306
VITE_BIN_LONGITUDE=32.538981266575874
VITE_BIN_LOCATION_LABEL=Mutundwe

# Firebase web app config (Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=smartiotwastemanagement.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://smartiotwastemanagement-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=smartiotwastemanagement
VITE_FIREBASE_STORAGE_BUCKET=smartiotwastemanagement.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database paths
VITE_FIREBASE_BIN_ROOT=smart_bin_01
VITE_FIREBASE_LIVE_STATUS_PATH=smart_bin_01/live_status
VITE_FIREBASE_COLLECTION_HISTORY_PATH=smart_bin_01/collection_history
